{
  "name": "scrapecreators",
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "description": "Unofficial TypeScript SDK for the ScrapeCreators API: public data from TikTok, Instagram, YouTube, Facebook, Twitter, Reddit and more",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "bun scripts/generate.ts && oxfmt src",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build"
  },
  "keywords": [
    "scrapecreators",
    "social-media",
    "scraping",
    "tiktok",
    "instagram",
    "youtube",
    "api-client",
    "typescript"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/scrapecreators.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/scrapecreators/issues"
  },
  "homepage": "https://github.com/gusnips/scrapecreators#readme",
  "engines": {
    "node": ">=18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
