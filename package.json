{
  "name": "scrapecreators",
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "description": "Unofficial TypeScript SDK for the ScrapeCreators API: public data from TikTok, Instagram, YouTube, Facebook, Twitter, Reddit and more",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "bun scripts/generate.ts && prettier --write src",
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build"
  },
  "keywords": [
    "scrapecreators",
    "social-media",
    "scraping",
    "tiktok",
    "instagram",
    "youtube",
    "api-client",
    "typescript"
  ],
  "author": "Gustavo Salom\u00e9 (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/scrapecreators.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/scrapecreators/issues"
  },
  "homepage": "https://github.com/gusnips/scrapecreators#readme",
  "engines": {
    "node": ">=18.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
